+#ifndef DISH2_VIZ_GETTERS_STINTROOTGETTER_HPP_INCLUDE
+#define DISH2_VIZ_GETTERS_STINTROOTGETTER_HPP_INCLUDE
+
+#include <functional>
+#include <string_view>
+
+#include "../../cell/Cell.hpp"
+#include "../../config/cfg.hpp"
+#include "../../genome/Genome.hpp"
+#include "../../genome/RootID.hpp"
+#include "../../world/ThreadWorld.hpp"
+
+namespace dish2 {
+
+/**
+ * Identity of the cell's ancestor at the outset of the current stint, as
+ * opposed to PhylogeneticRootGetter's ancestor at simulation outset.
+ */
+template<typename Spec>
+class StintRootGetter {
+
+  std::reference_wrapper<const dish2::ThreadWorld<Spec>> thread_world;
+
+public:
+
+  static constexpr std::string_view GetName() { return "StintRoot"; }
+
+  using value_type = size_t;
+
+  template< typename... Args >
+  StintRootGetter(
+    const dish2::ThreadWorld<Spec>& thread_world_,
+    Args&&...
+  )
+  : thread_world(thread_world_)
+  {}
+
+  const value_type Get(
+    const size_t cell_idx, const size_t cardinal_idx=0
+  ) const {
+    if ( thread_world.get().GetCell( cell_idx ).genome.has_value() ) {
+      return thread_world.get().GetCell(
+        cell_idx
+      ).GetGenome().stint_root_id.GetID();
+    } else {
+      const static Genome< Spec > genome{};
+      return genome.stint_root_id.GetID();
+    }
+
+  }
+
+  size_t GetNumCells() const { return thread_world.get().GetSize(); }
+
+  size_t GetNumCardinals( const size_t cell_idx=0 ) const {
+    return thread_world.get().GetCell( cell_idx ).GetNumCardinals();
+  }
+
+};
+
+} // namespace dish2
+
+#endif // #ifndef DISH2_VIZ_GETTERS_STINTROOTGETTER_HPP_INCLUDE
