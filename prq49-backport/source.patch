diff --git a/include/dish2/cell/cardinal_iterators/RepLevRequestWrapper.hpp b/include/dish2/cell/cardinal_iterators/RepLevRequestWrapper.hpp
new file mode 100644
index 00000000..dc4980a4
--- /dev/null
+++ b/include/dish2/cell/cardinal_iterators/RepLevRequestWrapper.hpp
@@ -0,0 +1,89 @@
+#pragma once
+#ifndef DISH2_CELL_CARDINAL_ITERATORS_REPLEVREQUESTWRAPPER_HPP_INCLUDE
+#define DISH2_CELL_CARDINAL_ITERATORS_REPLEVREQUESTWRAPPER_HPP_INCLUDE
+
+#include <type_traits>
+
+#include "../../../../third-party/Empirical/include/emp/base/vector.hpp"
+
+#include "../../peripheral/readable_state/ReadableState.hpp"
+
+#include "../Cardinal.hpp"
+
+namespace dish2 {
+
+template<typename Spec>
+class RepLevRequestWrapper
+: public emp::vector<Cardinal<Spec>>::iterator {
+
+  using parent_t = typename emp::vector<Cardinal<Spec>>::iterator;
+
+public:
+
+  RepLevRequestWrapper() = default;
+
+  RepLevRequestWrapper(const parent_t& in) : parent_t(in) {}
+
+  using value_type = dish2::RepLevRequest<Spec>;
+  using pointer = value_type*;
+  using reference = value_type&;
+
+  value_type& operator*() {
+    return parent_t::operator*().peripheral.readable_state.template Get<
+      dish2::RepLevRequest<Spec>
+    >();
+  }
+
+  value_type* operator->() { return &operator*(); }
+
+  RepLevRequestWrapper& operator++() {
+    parent_t::operator++();
+    return *this;
+  }
+
+  RepLevRequestWrapper operator++(int) {
+    const auto res = *this;
+    operator++();
+    return res;
+  }
+
+  RepLevRequestWrapper& operator--() {
+    parent_t::operator--();
+    return *this;
+  }
+
+  RepLevRequestWrapper operator--(int) {
+    RepLevRequestWrapper res{ *this };
+    res -= 1;
+    return res;
+  }
+
+  template<
+    typename RHS,
+    typename = typename std::enable_if<
+      std::is_arithmetic<RHS>::value, RHS
+    >::type
+  >
+  RepLevRequestWrapper operator+(const RHS rhs) {
+    RepLevRequestWrapper res{ *this };
+    res += rhs;
+    return res;
+  }
+
+  template<
+    typename RHS,
+    typename = typename std::enable_if<
+      std::is_arithmetic<RHS>::value, RHS
+    >::type
+  >
+  RepLevRequestWrapper operator-(const RHS rhs) {
+    RepLevRequestWrapper res{ *this };
+    res -= rhs;
+    return res;
+  }
+
+};
+
+} // namespace dish2
+
+#endif // #ifndef DISH2_CELL_CARDINAL_ITERATORS_REPLEVREQUESTWRAPPER_HPP_INCLUDE
diff --git a/include/dish2/introspection/get_live_cardinal_kin_group_ids.hpp b/include/dish2/introspection/get_live_cardinal_kin_group_ids.hpp
new file mode 100644
index 00000000..518b15c3
--- /dev/null
+++ b/include/dish2/introspection/get_live_cardinal_kin_group_ids.hpp
@@ -0,0 +1,46 @@
+#pragma once
+#ifndef DISH2_INTROSPECTION_GET_LIVE_CARDINAL_KIN_GROUP_IDS_HPP_INCLUDE
+#define DISH2_INTROSPECTION_GET_LIVE_CARDINAL_KIN_GROUP_IDS_HPP_INCLUDE
+
+#include <algorithm>
+#include <iterator>
+#include <vector>
+
+#include "../cell/Cell.hpp"
+#include "../world/iterators/LiveCellIterator.hpp"
+#include "../world/ThreadWorld.hpp"
+
+#include "count_cardinals.hpp"
+
+namespace dish2 {
+
+// kin group id at the given level of the cell containing each live cardinal
+template< typename Spec >
+std::vector<size_t> get_live_cardinal_kin_group_ids(
+  const dish2::ThreadWorld<Spec>& world, const size_t lev
+) {
+
+  const auto& population = world.population;
+
+  std::vector<size_t> res;
+  res.reserve( dish2::count_cardinals<Spec>( world ) );
+
+  std::for_each(
+    dish2::LiveCellIterator<Spec>::make_begin( population ),
+    dish2::LiveCellIterator<Spec>::make_end( population ),
+    [&]( const auto& cell ){
+      std::fill_n(
+        std::back_inserter( res ),
+        cell.GetNumCardinals(),
+        cell.genome->kin_group_id.GetBuffer()[ lev ]
+      );
+    }
+  );
+
+  return res;
+
+}
+
+} // namespace dish2
+
+#endif // #ifndef DISH2_INTROSPECTION_GET_LIVE_CARDINAL_KIN_GROUP_IDS_HPP_INCLUDE
