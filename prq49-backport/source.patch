+
+/**
+ * Parses a json dict of fields (e.g., {"update": 7}) for write_jsonl_record.
+ */
+inline rapidjson::Document parse_label_fields_json(
+  const std::string& label_fields_json
+) {
+
+  rapidjson::Document label_fields;
