+#pragma once
+#ifndef DISH2_VIZ_GETTERS_ELIGIBLESPAWNREQUESTGETTER_HPP_INCLUDE
+#define DISH2_VIZ_GETTERS_ELIGIBLESPAWNREQUESTGETTER_HPP_INCLUDE
+
