+  ) : thread_world( thread_world_ ), lev( lev_ ) {
+    Refresh();
+  }
+
+  template<typename ValueType>
+  std::string Paint(const ValueType& cardi_coord) const {
+    if ( cardi_coord_to_live_cardi_idx_translator.count(
+      cardi_coord
+    ) == 0 ) return "transparent";
+
